+        headers = {"Content-Length": str(hi-lo+1), "Accept-Ranges": "bytes"}
+        if status == 206:
+            headers["Content-Range"] = f"bytes {lo}-{hi}/{total}"
+
+        def chunks():
+            if request.method == "HEAD":
+                return
+            if lo < 44:
+                yield header[lo:min(hi+1, 44)]
+            begin, remaining = max(lo, 44)-44, hi-max(lo, 44)+1
