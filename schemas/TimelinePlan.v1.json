{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "fps": {
      "type": "string"
    },
    "sample_rate": {
      "const": 48000
    },
    "source_frames": {
      "type": "integer",
      "minimum": 0
    },
    "output_frames": {
      "type": "integer",
      "minimum": 0
    },
    "source_samples": {
      "type": "integer",
      "minimum": 0
    },
    "output_samples": {
      "type": "integer",
      "minimum": 0
    },
    "pieces": {
      "type": "array"
    },
    "dubs": {
      "type": "array"
    },
    "utterances": {
      "type": "array"
    },
    "quality_status": {
      "const": "REVIEW"
    },
    "frame_samples": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "source_frame_samples": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "audio_gap_policy": {
      "const": "immediate_en_zh_v1"
    }
  },
  "required": [
    "fps",
    "sample_rate",
    "source_frames",
    "output_frames",
    "source_samples",
    "output_samples",
    "pieces",
    "dubs",
    "utterances",
    "quality_status"
  ],
  "additionalProperties": false,
  "dependentRequired": {
    "frame_samples": [
      "source_frame_samples"
    ],
    "source_frame_samples": [
      "frame_samples"
    ]
  }
}
