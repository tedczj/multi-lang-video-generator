{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "speaker_id": {
      "type": "string"
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "audio_sha512": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "source_audio_artifact_id": {
      "type": "string"
    },
    "start_sample": {
      "type": "integer",
      "minimum": 0
    },
    "end_sample": {
      "type": "integer",
      "minimum": 1
    },
    "sample_rate": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "speaker_id",
    "text",
    "audio_sha512",
    "source_audio_artifact_id",
    "start_sample",
    "end_sample",
    "sample_rate"
  ],
  "additionalProperties": false
}
