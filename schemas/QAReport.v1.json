{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "overall": {
      "enum": [
        "REVIEW",
        "FAIL",
        "PASS"
      ]
    },
    "checks": {
      "type": "array"
    },
    "render_sha512": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "layout_sha512": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "raw_audio_sha512": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-f0-9]{128}$"
      }
    }
  },
  "required": [
    "overall",
    "checks"
  ],
  "additionalProperties": false
}
