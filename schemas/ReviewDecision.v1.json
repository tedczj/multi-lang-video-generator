{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "render_artifact_id": {
      "type": "string",
      "minLength": 1
    },
    "render_sha512": {
      "type": "string",
      "pattern": "^[a-f0-9]{128}$"
    },
    "reviewer": {
      "type": [
        "string",
        "null"
      ]
    },
    "decision": {
      "enum": [
        "REVIEW",
        "FAIL",
        "PASS"
      ]
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "REVIEW",
              "FAIL",
              "PASS"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "reason"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "render_artifact_id",
    "render_sha512",
    "reviewer",
    "decision",
    "checks"
  ],
  "additionalProperties": false
}
