{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "batch_id": {
      "type": "string"
    },
    "source_artifact_id": {
      "type": "string"
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "properties": {
          "unit_id": {
            "type": "string"
          },
          "source_text": {
            "type": "string"
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "unit_id",
          "source_text",
          "text"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "batch_id",
    "source_artifact_id",
    "items"
  ],
  "additionalProperties": false
}
